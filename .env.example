# ==========================================
# GuardAI Environment Configuration
# ==========================================

# Application
PORT=4000
NODE_ENV=development

# Kipps API (Hackathon Target)
# Currently mocked, will be replaced with real endpoints
KIPPS_API_BASE_URL=https://api.kipps.ai/v1
KIPPS_API_KEY=mock_kipps_key_for_now

# Persistence & Queues (Needed for Phase 3+)
REDIS_URL=redis://localhost:6379
DATABASE_URL=postgres://user:password@localhost:5432/guardai

# Dashboard Security
DASHBOARD_SECRET=hackathon_secret_do_not_use_in_prod