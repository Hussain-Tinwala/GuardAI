      "parameters": {
        "jsCode": "const COMPLIANCE_RULES = { MAX_CALLS_PER_24H: 2, QUIET_HOUR_START: 21, QUIET_HOUR_END: 9 };\nconst data = $input.first().json;\n\nconst istHour = new Date(new Date().toLocaleString(\"en-US\", { timeZone: \"Asia/Kolkata\" })).getHours();\nconst isQuietHours = istHour >= COMPLIANCE_RULES.QUIET_HOUR_START || istHour < COMPLIANCE_RULES.QUIET_HOUR_END;\n\nlet compliance;\nif (isQuietHours) {\n  compliance = { allowed: false, status: 'QUEUED_FOR_WINDOW', reason: 'TRAI quiet hours active (9PM-9AM IST). Queuing for morning.' };\n} else {\n  compliance = { allowed: true, status: 'APPROVED', reason: 'Passed all compliance checks.' };\n}\n\nreturn { json: { ...data, compliance } };"
      },
