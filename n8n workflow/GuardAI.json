nalFrustration = Math.floor(baseFrustration * vipMultiplier);\nfinalFrustration = Math.min(finalFrustration, 100);\n\nreturn {\n  json: {\n    userMessage,\n    detectedLanguage,\n    languageName,\n    customerTier,\n    frustrationScore: finalFrustration,\n    isHighUrgency: finalFrustration >= 50\n  }\n};"
