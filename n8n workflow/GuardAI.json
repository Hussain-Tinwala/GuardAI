    {
      "parameters": {
        "jsCode": "const data = $input.first().json;\nconst transcript = (data.transcript || '').toLowerCase();\nconst langName = data.languageName || 'English';\nconst frustration = data.frustrationScore || 50;\n\nlet summary;\n\n// Original Summary Keyword Classification\nif (transcript.includes('payment') || transcript.includes('refund') || transcript.includes('money') || transcript.includes('deduct')) {\n  summary = 'User is experiencing a payment or refund-related issue.';\n} else if (transcript.includes('login') || transcript.includes('password') || transcript.includes('locked')) {\n  summary = 'User is locked out of their account or having login issues.';\n} else if (transcript.includes('fraud') || transcript.includes('stolen') || transcript.includes('compromised')) {\n  summary = 'URGENT: User is reporting potential fraud or a security breach.';\n} else {\n  summary = `User's last message was regarding: \"...${(data.transcript || '').slice(-50)}\"`;\n}\n\n// Enterprise Voice Briefing Payload\nconst voiceBriefing = {\n  customer_language: langName,\n  frustration_score: frustration,\n  user_transcript: data.transcript || '',\n  summary: summary,\n  system_prompt_override: `You are GuardAI Senior Voice Specialist speaking in ${langName}. The customer frustration score is ${frustration}/100. Issue Summary: ${summary}. Reassure them immediately.`\n};\n\nreturn { \n  json: { \n    ...data, \n    contextSummary: summary,\n    voiceBriefing: voiceBriefing\n  } \n};"
      },
