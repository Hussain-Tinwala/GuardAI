      "parameters": {
        "jsCode": "const inputItem = $input.first().json;\nconst userMessage = $('DPDP PII Redaction Shield').first().json.chatInput || '';\nconst userPhone = $('Set Variables').first().json.USER_PHONE || '+91removed';\n\n// Safely pull analyzer data if node exists, otherwise set defaults\nlet analyzer = { detectedLanguage: 'en-IN', languageName: 'English', frustrationScore: 15, isHighUrgency: false };\ntry {\n    if ($('Language & Sentiment Analyzer').first()) {\n        analyzer = $('Language & Sentiment Analyzer').first().json;\n    }\n} catch (e) {\n    // Node not present yet, default values remain\n}\n\nlet botReplyText = '';\n\n// 1. PARSE KIPPS SSE STREAMING TOKENS\nconst rawData = typeof inputItem === 'string' ? inputItem : (inputItem.data || JSON.stringify(inputItem));\n\nif (rawData.includes('token')) {\n    const lines = rawData.split('\\n');\n    let accumulatedTokens = '';\n    \n    for (let line of lines) {\n        if (line.includes('data:')) {\n            try {\n                const jsonStr = line.substring(line.indexOf('data:') + 5).trim();\n                const parsed = JSON.parse(jsonStr);\n                if (parsed.token) {\n                    accumulatedTokens += parsed.token;\n                }\n            } catch (e) {}\n        }\n    }\n    \n    if (accumulatedTokens.trim()) {\n        botReplyText = accumulatedTokens.replace(/<[^>]*>/g, '').trim();\n    }\n}\n\n// 2. FALLBACK TO STANDARD JSON KEYS IF NOT A STREAM\nif (!botReplyText) {\n    if (inputItem.reply) botReplyText = inputItem.reply;\n    else if (inputItem.message) botReplyText = inputItem.message;\n    else if (inputItem.text) botReplyText = inputItem.text;\n}\n\n// 3. FALLBACK ONLY IF NO TEXT WAS EXTRACTED AT ALL\nif (!botReplyText) {\n    const msg = userMessage.toLowerCase();\n    if (msg.includes('fraud') || msg.includes('stolen') || msg.includes('money') || msg.includes('deduct') || analyzer.isHighUrgency) {\n        botReplyText = \"URGENT_ESCALATION\";\n    } else if (msg.includes('policy') || msg.includes('return')) {\n        botReplyText = \"Our standard return policy allows you to return items within 30 days of purchase for a full refund. Let me know if you need help starting a return!\";\n    } else {\n        botReplyText = \"Thank you for reaching out. GuardAI is analyzing your request. Could you provide a bit more detail?\";\n    }\n}\n\n// 4. EVALUATE ESCALATION CRITERIA\nconst isUrgent = botReplyText.includes('URGENT_ESCALATION') || \n                 userMessage.toLowerCase().includes('fraud') || \n                 userMessage.toLowerCase().includes('stolen') ||\n                 userMessage.toLowerCase().includes('compromised') ||\n                 analyzer.isHighUrgency;\n\nreturn {\n  json: {\n    userId: userPhone,\n    transcript: userMessage,\n    botReplyText: isUrgent ? \"Critical topic detected. GuardAI is initiating voice escalation.\" : botReplyText,\n    detectedLanguage: analyzer.detectedLanguage,\n    languageName: analyzer.languageName,\n    frustrationScore: analyzer.frustrationScore,\n    decision: {\n      action: isUrgent ? 'ESCALATE' : 'RESOLVED',\n      priorityScore: isUrgent ? Math.max(analyzer.frustrationScore, 85) : 0,\n      reason: isUrgent \n        ? `Critical escalation triggered (${analyzer.languageName}, Frustration: ${analyzer.frustrationScore}/100)` \n        : 'Query handled autonomously'\n    }\n  }\n};"
